# DeepSeek API
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro

# 备选 LLM（Kimi / Qwen）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_K3_MODEL=kimi-k3
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_37_MAX_MODEL=qwen3.7-max
QWEN_36_FLASH_MODEL=qwen3.6-flash

# 服务
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# 前端地址（CORS）
FRONTEND_URL=http://localhost:3000

# 数据库（开发环境默认 SQLite）
DATABASE_URL=sqlite+aiosqlite:///./data_analysis_agent.db

# 安全（JWT）
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 安全（密码重置 JWT）—— 必须与 JWT_SECRET_KEY 不同
RESET_JWT_SECRET_KEY=your_reset_jwt_secret_key_here

# 开发模式（仅 DEBUG=true 时允许 dev-token）
DEV_TOKEN=dev-token
ALLOW_DEV_TOKEN=true

# 微信公众号网页授权
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

# 客服微信号（售后占位）：留空=占位态"敬请期待"；填入真实号后前端即切换为可复制真实号
CUSTOMER_SERVICE_WECHAT_ID=

# 邮件 SMTP 配置
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=预演

# 速率限制
RATE_LIMIT_PER_MINUTE=60

# ===== 支付 / 自助在线成交（《VIBE 全流程手册》P0）=====
# 线上成交开关：True（默认）= 允许 C 端在线下单 + 支付回调自动激活；False=回归线下手动开通
ENABLE_ONLINE_PAYMENT=true

# 支付回调安全（微信/支付宝服务端 → 本服务）
PAYMENT_CALLBACK_TOKEN=your_callback_token_here
PAYMENT_ALLOWED_IPS=

# ── 微信支付 Native（扫码）──（商户平台 pay.weixin.qq.com → API安全 获取）
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_MCH_CERT_SERIAL=
WXPAY_MCH_PRIVATE_KEY_PATH=
WXPAY_PLATFORM_CERT_SERIAL=
WXPAY_PLATFORM_CERT_PATH=
WXPAY_NOTIFY_URL=https://你的域名/api/v1/payment/wxpay/notify
WXPAY_REDIRECT_URL=

# ── 支付宝手机网站/当面付 ──
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://你的域名/api/v1/payment/alipay/notify
# 支付宝网关（沙箱 vs 正式）
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 套餐限制
FREE_PLAN_PROJECT_LIMIT=3
FREE_PLAN_SIMULATION_LIMIT_PER_WEEK=3
FREE_PLAN_EXPORT_LIMIT_PER_WEEK=3
